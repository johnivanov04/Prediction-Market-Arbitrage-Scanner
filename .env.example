# ---------------------------------------------------------------------------
# predarb Phase 1 configuration.
# Copy to .env and fill in. .env is gitignored; never commit real credentials.
# ---------------------------------------------------------------------------

# Environment selector: "demo" or "prod".
# Start on demo. Phase 1 places no orders in either environment.
PREDARB_KALSHI_ENV=demo

# --- Kalshi credentials -----------------------------------------------------
# Created in Kalshi account settings. Credentials are NOT shared between the
# demo and production environments; you need a separate pair for each.
# The private key is an RSA key used for RSA-PSS/SHA-256 request signing.
PREDARB_KALSHI_API_KEY_ID=
PREDARB_KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem

# Public market-data endpoints do not require credentials. Leave the two
# values above blank to run metadata/orderbook capture unauthenticated.

# --- Storage ----------------------------------------------------------------
PREDARB_DATABASE_URL=postgresql+psycopg://predarb:predarb@localhost:5432/predarb
PREDARB_RAW_JOURNAL_DIR=./data/raw

# --- Capture / staleness ----------------------------------------------------
# A book older than this is not eligible for any arbitrage alert.
PREDARB_MAX_BOOK_AGE_MS=2000
# Periodic REST cross-check of the reconstructed book, in seconds. 0 disables.
PREDARB_BOOK_VALIDATION_INTERVAL_S=60

# --- Logging ----------------------------------------------------------------
PREDARB_LOG_LEVEL=INFO
PREDARB_LOG_FORMAT=json

# --- Test toggles -----------------------------------------------------------
# Set to 1 to allow tests marked "live" to contact the real Kalshi API.
PREDARB_ALLOW_LIVE_TESTS=0
