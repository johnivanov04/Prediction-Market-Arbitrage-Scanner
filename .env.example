# ---------------------------------------------------------------------------
# predarb Phase 1 configuration.
#
# Copy to .env and fill in. .env is gitignored.
#
# NAMES ONLY -- never commit real values. The API key id is credential material
# even though it is less sensitive than the private key, and the private key
# must never be pasted into this file or any other file in the repository.
# ---------------------------------------------------------------------------

# Environment selector: production | prod | demo
# Kalshi credentials are ENVIRONMENT-SPECIFIC. A production key does not work
# against demo, and the resulting 401 is indistinguishable from a bad key.
KALSHI_ENVIRONMENT=demo

# --- Kalshi credentials -----------------------------------------------------
# Created in Kalshi account settings. READ scope is sufficient and preferred;
# Phase 1 never submits an order and a write-scoped key changes nothing.
#
# The private key is an RSA key used for RSA-PSS/SHA-256 request signing. Store
# it OUTSIDE this repository and point at it by path, e.g.
#
#   mkdir -p ~/.config/predarb/kalshi
#   mv /path/to/downloaded-key.pem ~/.config/predarb/kalshi/kalshi-key.pem
#   chmod 600 ~/.config/predarb/kalshi/kalshi-key.pem
#
# predarb warns (never blocks) if the key file is readable beyond its owner.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Credentials are needed only for:
#   - the WebSocket (it rejects unauthenticated connections with HTTP 401)
#   - GET /account/limits and GET /account/endpoint_costs
# Public series/events/markets/orderbook REST endpoints need none, so metadata
# and order-book research run with these left blank.

# The PREDARB_-prefixed spellings are also accepted, if you prefer them:
#   PREDARB_KALSHI_ENV, PREDARB_KALSHI_API_KEY_ID, PREDARB_KALSHI_PRIVATE_KEY_PATH

# --- Storage ----------------------------------------------------------------
PREDARB_DATABASE_URL=postgresql+psycopg://predarb:predarb@localhost:5432/predarb
PREDARB_RAW_JOURNAL_DIR=./data/raw

# --- Capture / staleness ----------------------------------------------------
# A book older than this is not eligible for any arbitrage alert.
PREDARB_MAX_BOOK_AGE_MS=2000
# Periodic REST cross-check of the reconstructed book, in seconds. 0 disables.
PREDARB_BOOK_VALIDATION_INTERVAL_S=60

# --- Logging ----------------------------------------------------------------
# Auth headers are redacted wherever headers are rendered. Note that enabling
# httpx/httpcore DEBUG logging directly (outside predarb) can still print
# request headers -- predarb's own logging never does.
PREDARB_LOG_LEVEL=INFO
PREDARB_LOG_FORMAT=json

# --- Test toggles -----------------------------------------------------------
# Set to 1 to allow tests marked "live" to contact the real Kalshi API.
PREDARB_ALLOW_LIVE_TESTS=0
